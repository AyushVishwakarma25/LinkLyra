rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPageOwner(pageId) {
      return signedIn() && (
        request.auth.uid == pageId ||
        (exists(/databases/$(database)/documents/pages/$(pageId)) && get(/databases/$(database)/documents/pages/$(pageId)).data.userId == request.auth.uid)
      );
    }

    // =========================
    // USERS (and Subcollections: subscriptions, payments, credit_transactions)
    // =========================

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/subscriptions/{subId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/payments/{paymentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/credit_transactions/{txId} {
      allow read, write: if isOwner(userId);
    }

    // Root level subscription and payment fallbacks
    match /subscriptions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Connection Test Document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if signedIn() && (
        request.auth.uid == paymentId ||
        (request.resource.data != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // =========================
    // PAGES
    // =========================

    match /pages/{pageId} {
      // Public can view and list creator pages
      allow read: if true;

      // Authenticated user creates their own page
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.auth.uid == pageId
      );

      // Only owner can update or delete
      allow update, delete: if isPageOwner(pageId);
    }

    // =========================
    // LINKS (Subcollection)
    // =========================

    match /pages/{pageId}/links/{linkId} {
      allow read: if true;
      allow write: if isPageOwner(pageId);
    }

    // =========================
    // SOCIAL LINKS (Subcollection)
    // =========================

    match /pages/{pageId}/socialLinks/{socialId} {
      allow read: if true;
      allow write: if isPageOwner(pageId);
    }

    // =========================
    // SECTIONS (Subcollection)
    // =========================

    match /pages/{pageId}/sections/{sectionId} {
      allow read: if true;
      allow write: if isPageOwner(pageId);
    }

    // =========================
    // LEADS & INQUIRIES (Subcollection & Root Fallback)
    // =========================

    match /pages/{pageId}/leads/{leadId} {
      // Public visitors can submit showing bookings, brand inquiries, and valuation requests
      allow create: if true;
      // Only the page owner can view and update lead statuses (CRM)
      allow read, update, delete: if isPageOwner(pageId);
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if signedIn();
    }

    // =========================
    // THEMES
    // =========================

    match /themes/{themeId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // ANALYTICS (Subcollection)
    // =========================

    match /pages/{pageId}/analytics/{eventId} {
      // Allow anonymous event creation for page views, link clicks, property views, showing requests, brand inquiries
      allow create: if request.resource.data.type in [
        "page_view", "link_click", "property_view", "showing_request", "brand_inquiry", "home_valuation", "media_kit_download"
      ];
      allow read: if isPageOwner(pageId);
      allow update, delete: if false;
    }

    // =========================
    // PROFILES & USERNAMES & LINKS (Root Collections)
    // =========================

    match /usernames/{username} {
      allow read: if true;
      allow write: if signedIn() && (
        !exists(/databases/$(database)/documents/usernames/$(username)) ||
        get(/databases/$(database)/documents/usernames/$(username)).data.userId == request.auth.uid
      );
    }

    match /domains/{domain} {
      allow read: if true;
      allow write: if signedIn() && (
        !exists(/databases/$(database)/documents/domains/$(domain)) ||
        get(/databases/$(database)/documents/domains/$(domain)).data.userId == request.auth.uid
      );
    }
    
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /links/{linkId} {
      allow read: if true;
      allow write: if signedIn() && (
        !exists(/databases/$(database)/documents/links/$(linkId)) ||
        get(/databases/$(database)/documents/links/$(linkId)).data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // =========================
    // DENY EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

