rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPageOwner(pageId) {
      return signedIn() && (
        request.auth.uid == pageId ||
        (exists(/databases/$(database)/documents/pages/$(pageId)) && get(/databases/$(database)/documents/pages/$(pageId)).data.userId == request.auth.uid)
      );
    }

    // =========================================================================
    // USERS (and Subcollections: subscriptions, payments, credit_transactions)
    // =========================================================================

    match /users/{userId} {
      // Owner can read their own user document
      allow read: if isOwner(userId);

      // On create, owner can create, but plan must equal 'free'
      allow create: if isOwner(userId)
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && (!('role' in request.resource.data) || request.resource.data.role == 'creator')
        && !('credits' in request.resource.data)
        && !('creditsRemaining' in request.resource.data);

      // Owner can write, but CANNOT change plan, role, credits*, or anything billing-related
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan',
          'role',
          'credits',
          'creditsMonthly',
          'creditsRemaining',
          'creditsUsed',
          'subscription',
          'subscriptions',
          'billing',
          'razorpayCustomerId',
          'subscriptionId'
        ])
      );

      allow delete: if isOwner(userId);
    }

    // Owner read only, NO client writes. Server-side writes use Admin SDK.
    match /users/{userId}/subscriptions/{subId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/payments/{paymentId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/credit_transactions/{txId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // =========================================================================
    // PAGES & PROFILES
    // =========================================================================

    match /pages/{pageId} {
      // Public read
      allow read: if true;

      // Authenticated user creates their own page without forbidden billing/plan/domain attributes
      allow create: if signedIn() && (
        request.auth.uid == pageId ||
        (request.resource.data != null && request.resource.data.userId == request.auth.uid)
      ) && !request.resource.data.keys().hasAny([
        'plan', 'role', 'customDomain', 'custom_domain', 'whiteLabel', 'white_label'
      ]);

      // Owner update, but userId, plan, role, customDomain, and whiteLabel are not client-writable
      allow update: if isPageOwner(pageId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId', 'plan', 'role', 'customDomain', 'custom_domain', 'whiteLabel', 'white_label'
        ])
      );

      allow delete: if isPageOwner(pageId);
    }

    match /profiles/{userId} {
      // Public read
      allow read: if true;

      // Authenticated owner create without forbidden billing/plan/domain attributes
      allow create: if isOwner(userId) && !request.resource.data.keys().hasAny([
        'userId', 'plan', 'role', 'customDomain', 'custom_domain', 'whiteLabel', 'white_label'
      ]);

      // Owner update, but userId, plan, role, customDomain, and whiteLabel are not client-writable
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId', 'plan', 'role', 'customDomain', 'custom_domain', 'whiteLabel', 'white_label'
        ])
      );

      allow delete: if isOwner(userId);
    }

    // =========================================================================
    // USERNAMES & DOMAINS
    // =========================================================================

    match /usernames/{username} {
      allow read: if true;

      // Create only if signed in, doc doesn't exist, data.userId == auth.uid, id matches ^[a-z0-9_]{3,30}$
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.userId == request.auth.uid
        && username.matches('^[a-z0-9_]{3,30}$');

      // No client updates
      allow update: if false;

      // Delete only by owner
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /domains/{domain} {
      // Public read, NO client writes (claimed via server function / Admin SDK)
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // ROOT LINKS COLLECTION (mirror of pages/{pageId}/links/{linkId})
    // addLink() writes to both subcollection AND root — this rule is required
    // =========================================================================

    match /links/{linkId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.profile_id == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.profile_id == request.auth.uid;
    }

    // =========================================================================
    // PAGES SUBCOLLECTIONS: LINKS, SOCIAL LINKS, SECTIONS
    // =========================================================================

    match /pages/{pageId}/links/{linkId} {
      allow read: if true;
      allow create, delete: if isPageOwner(pageId);

      // Owner update OR anonymous clickCount increment by exactly 1
      allow update: if isPageOwner(pageId) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) &&
        request.resource.data.clickCount == resource.data.clickCount + 1
      );
    }

    match /pages/{pageId}/socialLinks/{socialId} {
      allow read: if true;
      allow write: if isPageOwner(pageId);
    }

    match /pages/{pageId}/sections/{sectionId} {
      allow read: if true;
      allow write: if isPageOwner(pageId);
    }

    // =========================================================================
    // PAGES SUBCOLLECTIONS: LEADS
    // =========================================================================

    match /pages/{pageId}/leads/{leadId} {
      // Public create with sanitization and validation
      allow create: if request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string 
        && request.resource.data.email.size() > 0 
        && request.resource.data.email.size() <= 200;

      // Owner read/update/delete
      allow read, update, delete: if isPageOwner(pageId);
    }

    // =========================================================================
    // PAGES SUBCOLLECTIONS: ANALYTICS
    // =========================================================================

    match /pages/{pageId}/analytics/{eventId} {
      // Public create with type allowlist, strict keys, timestamp == request.time
      allow create: if request.resource.data.type in [
          'page_view', 'link_click', 'property_view', 'showing_request',
          'brand_inquiry', 'home_valuation', 'media_kit_download', 'package_booking',
          'music_booking', 'podcast_sponsorship', 'general_contact'
        ]
        && request.resource.data.keys().hasOnly([
          'type', 'linkId', 'visitorId', 'country', 'device', 'browser', 'referrer', 'timestamp', 'expireAt'
        ])
        && request.resource.data.timestamp == request.time;

      allow read: if isPageOwner(pageId);
      allow update, delete: if false;
    }

    // =========================================================================
    // PAGES SUBCOLLECTIONS: STATS (Aggregated Daily Rollups)
    // =========================================================================

    match /pages/{pageId}/stats/{date} {
      // Owner can read aggregated daily statistics
      allow read: if isPageOwner(pageId);
      // Client writes disabled (Only Cloud Functions / Admin SDK writes)
      allow write: if false;
    }

    // =========================================================================
    // THEMES & SYSTEM
    // =========================================================================

    match /themes/{themeId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
